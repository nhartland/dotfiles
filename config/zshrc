# Return now if running inside Neovim's :terminal
if [[ -n "$NVIM" ]]; then
  echo "Detected Neovim PTY → skipping .zshrc"
  return
fi

# Antidote package manager for zsh
source ~/.config/antidote/antidote.zsh
antidote load ${ZDOTDIR:-$HOME}/.zsh_plugins.txt

# Detect OS
if [[ "$OSTYPE" == "darwin"* ]]; then
  # macOS-specific settings
  BREW_PREFIX=$(brew --prefix)
  source "$BREW_PREFIX/share/zsh/site-functions"
  fpath+=("$BREW_PREFIX/share/zsh/site-functions")
  eval "$("$BREW_PREFIX/bin/brew" shellenv)"
  # Kitty themes. Remote control is socket-based (see config/kitty), and the
  # socket only exists for a kitty started after that config landed -- so gate
  # on KITTY_LISTEN_ON rather than KITTY_WINDOW_ID.
  if [[ -n "$KITTY_LISTEN_ON" ]]; then
      kitten @ set-colors -c "$HOME/.config/kitty/current-theme.conf" 2>/dev/null
  fi
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
  # Linux-specific settings
fi

#Timestamp format
HIST_STAMPS="dd.mm.yyyy"

# Prompt
autoload -Uz promptinit; promptinit; prompt pure
zstyle :prompt:pure:git:stash show yes

# Enable history search with Up/Down arrows
bindkey '^[[A' history-search-backward
bindkey '^[[B' history-search-forward

source ~/.shellrc

alias jp="poetry -P ~/.jupyter-hub run jupyter lab"
alias vim="nvim"
alias vi="nvim"
alias v="nvim"
command -v eza >/dev/null && alias ls="eza"

# Z/fzf setup
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
if command -v fzf >/dev/null; then
  # fzf >= 0.48 generates the shell integration; older packages ship it as files.
  if fzf_init=$(fzf --zsh 2>/dev/null); then
    eval "$fzf_init"
  else
    for f in /usr/share/doc/fzf/examples/{key-bindings,completion}.zsh; do
      [[ -r $f ]] && source $f
    done
  fi
  unset fzf_init f
fi

zoxide_fzf_cd() {
  local dir
  dir=$(
    zoxide query --list --score |
    fzf --height 40% --layout=reverse --info=inline \
        --nth=2.. --tac --no-sort \
        --bind='enter:become:echo {2..}'
  )
  [[ -n $dir ]] && cd "$dir"
}
bindkey -s '^D' 'zoxide_fzf_cd\n'



export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.poetry/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"


